{
    "manifest_version": 3,
    "short_name": "__MSG_Abbr__",
    "name": "__MSG_appName__",
    "description": "__MSG_appDescription__",
    "version": "0.0.1",
    "default_locale": "en",
    "icons": {
        "32": "icon32.png",
        "48": "icon48.png",
        "64": "icon64.png",
        "128": "icon128.png"
    },
    "background": {
        "service_worker": "background_script.js"
    },
    "action": {
      "default_popup": "popup.html"
    },
    "permissions": [
      "profiles",
      "diskCache",
      "hstsCache",
      "sqliteCache",
      "localStorages",
      "urlRequest",
      "dns",
      "fileSystem",
      "fileSystem.write"
    ],
    "sockets": {
      "tcp": {
         "connect": [ "*:*" ]
      },
      "tcpServer": {
         "listen": [ "*:*" ]
      },
      "udp": {
         "bind": [ "*:*" ],
         "send": [ "*:*" ]
      }
    }
}
